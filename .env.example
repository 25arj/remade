# Reddit API (create a "script" app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=lead-agent:v1.0 (by u/your_username)

# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Slack incoming webhook URL (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# Google Sheets - shared lead log for both the Reddit lane and the cold
# email lane. Create a service account in Google Cloud, download its JSON
# key, and share your Sheet with the service account's email address
# (Editor access).
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=

# Google Programmable Search Engine (cold email lead sourcing). Create one
# at https://programmablesearchengine.google.com/ (search the whole web),
# then get an API key at https://console.cloud.google.com/apis/credentials
# for the "Custom Search API".
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Gmail (cold email sending + reply detection). In Google Cloud Console,
# enable the Gmail API and create an OAuth client ID of type "Desktop app",
# download its JSON as gmail_credentials.json. First run opens a browser
# to authorize your Gmail account; after that it's cached in the token file.
GMAIL_OAUTH_CREDENTIALS_FILE=gmail_credentials.json
GMAIL_TOKEN_FILE=state/gmail_token.json
FROM_EMAIL=you@example.com
